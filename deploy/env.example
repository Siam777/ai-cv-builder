# ── Server & Deployment ──────────────────────────────────────────────
NODE_ENV=production
HTTP_PORT=7892
CV_ENV_FILE=production.env
CV_HOST_DATA_DIR=/opt/elfasys/data/ai-cv-builder/data

# Public URL of the application
APP_ORIGIN=https://cv.elfasyssolution.com

# ── Better Auth & Security ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ── Optional Google Sign-In ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email Delivery (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
AUTH_EMAIL_FROM=noreply@elfasyssolution.com

# ── Database (Turso or local file SQLite) ──────────────────────────────
# For Turso:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# For local persistent SQLite on VPS:
# TURSO_DATABASE_URL=file:/app/data/cv-builder.db

# ── AI Services (OpenAI) ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_USER_LIMIT=20
AI_DAILY_GLOBAL_LIMIT=200

# ── Stripe Monetization ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=
