# Local development: run npm run db:setup to create SQLite and a private secret.
APP_ORIGIN=http://localhost:3000
# Use a random secret of at least 32 characters; never commit the real value.
BETTER_AUTH_SECRET=
# Deployment: configure both values from your Turso database, then run db:setup.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Server-only OpenAI configuration. No key is included in source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
AI_DAILY_USER_LIMIT=20
AI_DAILY_GLOBAL_LIMIT=200
