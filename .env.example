# Local development: run npm run db:setup to create SQLite and a private secret.
APP_ORIGIN=http://localhost:3000
# Use a random secret of at least 32 characters; never commit the real value.
BETTER_AUTH_SECRET=
# Optional Google sign-in. Configure both values; never expose the secret to clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register APP_ORIGIN + /api/auth/callback/google as the exact Google redirect URI.
# Transactional authentication email: configure a verified sender with Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Local tests only: writes private links into ignored data/auth-email-outbox/.
# AUTH_EMAIL_MODE=file
# Deployment: configure both values from your Turso database, then run db:setup.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Server-only OpenAI configuration. No key is included in source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_DAILY_USER_LIMIT=20
AI_DAILY_GLOBAL_LIMIT=200

# Stripe billing and monetization (offline simulated checkout is enabled if omitted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=

